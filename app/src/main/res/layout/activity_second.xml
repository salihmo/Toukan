<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/background"
    tools:context=".activities.QuizActivity"
    android:indeterminateTintMode="src_atop"
    android:indeterminateTint="@android:color/holo_orange_light"
    >


    <LinearLayout
        android:id="@+id/ll_question"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_gravity="center"
        android:padding="15dp"
        android:gravity="center"
        android:visibility="invisible">

        <TextView
            android:id="@+id/tv_question"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            android:gravity="center"
            android:text="@string/what_is_the_pinyin_for_this_character"
            android:textColor="#363A43"
            android:textSize="30sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/iv_image"
            android:layout_width="249dp"
            android:layout_height="200dp"
            android:layout_marginTop="5dp"
            android:contentDescription="@string/character"
            android:src="@drawable/wo" />

        <LinearLayout
        android:id="@+id/progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal" >

            <ProgressBar
                android:id="@+id/progressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:indeterminateTint="@color/colorPrimaryDark"
                android:max="10"
                android:progress="0" />

            <TextView
            android:id="@+id/tv_progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="15dp"
            android:textColorHint="#7A8089"
            android:textSize="20sp"

            android:textStyle="bold"
            android:text="@string/_0_10" />

    </LinearLayout>
        <LinearLayout
            android:id="@+id/first_two_options"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:includeFontPadding="false"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_option_one"
                android:layout_width="172dp"
                android:layout_height="wrap_content"
                android:layout_margin="0dp"
                android:background="@drawable/option_border"
                android:gravity="center"
                android:includeFontPadding="true"
                android:padding="28dp"
                android:text="@string/w"
                android:textColor="@android:color/black"
                android:textSize="23sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_option_two"
                android:layout_width="172dp"
                android:layout_height="match_parent"
                android:layout_margin="0dp"
                android:background="@drawable/option_border"
                android:gravity="center"
                android:includeFontPadding="true"
                android:padding="28dp"
                android:text="@string/gu"
                android:textColor="@android:color/black"
                android:textSize="23sp"
                android:textStyle="bold" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/bottom_two_options"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_option_three"
                android:layout_width="172dp"
                android:layout_height="match_parent"
                android:layout_margin="0dp"
                android:background="@drawable/option_border"
                android:gravity="center"
                android:includeFontPadding="true"
                android:padding="28dp"
                android:text="@string/t"
                android:textColor="@android:color/black"
                android:textSize="23sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_option_four"
                android:layout_width="173dp"
                android:layout_height="97dp"
                android:layout_margin="0dp"
                android:background="@drawable/option_border"
                android:gravity="center"
                android:includeFontPadding="false"
                android:padding="28dp"
                android:text="@string/n"
                android:textColor="@android:color/black"
                android:textSize="23sp"
                android:textStyle="bold" />

        </LinearLayout>

        <Button
            android:id="@+id/btn_submit"
            android:layout_width="232dp"
            android:layout_height="73dp"
            android:layout_margin="10dp"
            android:background="@color/colorPrimary"
            android:backgroundTint="@android:color/holo_orange_light"
            android:text="@string/submit"
            android:textColor="@android:color/white"
            android:textSize="30sp"
            android:textStyle="bold" />


    </LinearLayout>

</ScrollView>



