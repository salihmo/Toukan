<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".fragments.StoreFragment"
    android:background="@drawable/backgroundaccount">


    <androidx.core.widget.NestedScrollView
        android:id="@+id/nestedScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/shelf1"
                android:layout_width="400dp"
                android:layout_height="100dp"
                android:layout_marginStart="7dp"
                android:layout_marginTop="175dp"
                android:layout_marginEnd="7dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintStart_toStartOf="parent"
                app:srcCompat="@drawable/ic_shelf_vector_modern" />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/shelf2"
                android:layout_width="400dp"
                android:layout_height="100dp"
                android:layout_marginStart="7dp"
                android:layout_marginTop="355dp"
                android:layout_marginEnd="7dp"
                app:srcCompat="@drawable/ic_shelf_vector_modern" />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/shelf3"
                android:layout_width="400dp"
                android:layout_height="100dp"
                android:layout_marginStart="7dp"
                android:layout_marginTop="530dp"
                android:layout_marginEnd="7dp"
                app:srcCompat="@drawable/ic_shelf_vector_modern" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/sticker_list_rv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="0dp"
                android:layout_marginTop="100dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="1.0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintVertical_bias="0.056" />


        </RelativeLayout>


    </androidx.core.widget.NestedScrollView>

    <TextView
        android:id="@+id/store_title"
        android:layout_width="wrap_content"
        android:layout_marginTop="5dp"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:layout_marginStart="185dp"
        android:text="Animals"
        android:textAppearance="@style/TextAppearance.MaterialComponents.Headline3"
        android:textColor="@android:color/white"
        android:textSize="30sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@+id/nestedScrollView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/store_token_image"
        android:layout_width="98dp"
        android:layout_height="50dp"
        android:layout_marginStart="175dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="5dp"
        android:layout_marginBottom="5dp"
        android:gravity="center_vertical"
        app:layout_constraintBottom_toTopOf="@+id/linearLayout"
        app:layout_constraintEnd_toStartOf="@+id/user_tokens_store"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/nestedScrollView"
        app:srcCompat="@drawable/ic_tokendrawinglogo" />

    <TextView
        android:id="@+id/user_tokens_store"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:layout_marginEnd="15dp"
        android:gravity="center_horizontal"
        android:text="Tokens"
        android:textAppearance="@style/TextAppearance.MaterialComponents.Headline3"
        android:textColor="@android:color/white"
        android:textSize="30sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toEndOf="@+id/linearLayout"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/linearLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="45dp"
        android:orientation="horizontal"
        android:padding="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/store_animals_button"
            android:layout_width="4dp"
            android:layout_height="38dp"
            android:background="@drawable/option_border"
            android:padding="3dp"
            android:layout_weight="1"
            android:src="@drawable/cat_icon" />

        <ImageView
            android:id="@+id/store_buildings_button"
            android:layout_width="4dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:background="@drawable/option_border"
            android:padding="3dp"
            android:src="@drawable/bank_icon" />

        <ImageView
            android:id="@+id/store_food_button"
            android:layout_width="4dp"
            android:layout_height="38dp"
            android:background="@drawable/option_border"
            android:padding="3dp"
            android:layout_weight="1"
            android:src="@drawable/food_icon" />

        <ImageView
            android:id="@+id/store_items_button"
            android:layout_width="4dp"
            android:layout_height="38dp"
            android:background="@drawable/option_border"
            android:padding="3dp"
            android:layout_weight="1"
            android:src="@drawable/items_icon" />

        <ImageView
            android:id="@+id/store_people_button"
            android:layout_width="4dp"
            android:layout_height="38dp"
            android:background="@drawable/option_border"
            android:padding="3dp"
            android:layout_weight="1"
            android:src="@drawable/doc_icon" />

        <ImageView
            android:id="@+id/store_vehicles_button"
            android:layout_width="4dp"
            android:layout_height="38dp"
            android:background="@drawable/option_border"
            android:padding="3dp"
            android:layout_weight="1"
            android:src="@drawable/motor_icon" />


    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/buy_sticker"
        android:layout_width="158dp"
        android:layout_height="86dp"
        android:layout_gravity="center"
        android:layout_marginStart="248dp"
        android:layout_marginEnd="28dp"
        android:layout_marginBottom="15dp"
        android:gravity="center"
        android:text="Buy"
        android:textColor="@android:color/holo_orange_light"
        android:textSize="32sp"
        android:textStyle="bold"
        app:backgroundTint="@android:color/white"
        app:cornerRadius="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.509"
        app:layout_constraintStart_toStartOf="parent"
        app:rippleColor="@android:color/holo_orange_light"
        app:strokeColor="@android:color/holo_orange_light" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/item_selected_english"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="120dp"
        android:layout_marginBottom="25dp"
        android:background="@drawable/store_border"
        android:gravity="center"
        android:padding="4dp"
        android:textStyle="bold"
        android:text="Welcome!"
        android:textSize="25dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/speech_store"
        app:rippleColor="@android:color/holo_orange_light"
        app:strokeColor="@android:color/holo_orange_light" />

    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/shopkeeper"
        android:layout_width="78dp"
        android:layout_height="95dp"
        android:layout_gravity="center"
        android:layout_marginEnd="320dp"
        android:layout_marginBottom="28dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/speech_store"
        app:lottie_autoPlay="true"
        app:lottie_loop="false"
        app:lottie_rawRes="@raw/bear_animation"
        app:lottie_repeatMode="restart"
        app:lottie_speed="3" />


    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/speech_store"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginEnd="160dp"
        android:layout_marginBottom="9dp"
        android:background="@drawable/bubble"
        android:gravity="center"
        android:padding="5dp"
        android:text="Huānyíng!"
        android:textSize="25dp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@+id/item_selected_english"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/buy_sticker"
        app:layout_constraintTop_toTopOf="@+id/buy_sticker"
        app:rippleColor="@android:color/holo_orange_light"
        app:strokeColor="@android:color/holo_orange_light" />


</androidx.constraintlayout.widget.ConstraintLayout>