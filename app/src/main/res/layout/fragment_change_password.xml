<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".fragments.ChangePasswordFragment"
    android:background="@drawable/backgroundonepassword">

    <!-- TODO: Update blank fragment layout -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/back_change_password_button"
            android:layout_width="33dp"
            android:layout_height="30dp"
            android:layout_marginStart="10dp"
            android:layout_marginTop="32dp"
            android:contentDescription="@string/back_arrow_change_password"
            android:gravity="center_vertical"
            android:background="@drawable/back_arrow"
            android:src="@drawable/ripple"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/forgot_password_title"
            android:layout_width="342dp"
            android:layout_height="89dp"
            android:layout_marginStart="40dp"
            android:layout_marginTop="24dp"
            android:text="@string/need_to_change_your_password"
            android:textSize="35sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.619"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />


        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tips_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="25dp"
            android:layout_marginEnd="16dp"
            android:text="@string/tips"
            android:textSize="28sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toTopOf="@+id/combination_tip"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/forgot_password_title"
            app:layout_constraintVertical_bias="0.52" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/avoid_personal_tip"
            android:layout_width="276dp"
            android:layout_height="24dp"
            android:layout_marginStart="20dp"
            android:layout_marginTop="28dp"
            android:layout_marginEnd="16dp"
            android:text="@string/avoid_using_personal_information"
            android:textSize="17sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/do_not_tell_tip" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/do_not_tell_tip"
            android:layout_width="298dp"
            android:layout_height="24dp"
            android:layout_marginStart="20dp"
            android:layout_marginTop="28dp"
            android:layout_marginEnd="16dp"
            android:text="@string/do_not_tell_anyone_your_password"
            android:textSize="17sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/combination_tip" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/combination_tip"
            android:layout_width="368dp"
            android:layout_height="42dp"
            android:layout_marginStart="20dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="5dp"
            android:text="@string/use_a_combination_of_uppercase_and_lowercase_letters_as_well_as_numbers_and_symbols"
            android:textSize="17sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toTopOf="@+id/lock"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tips_title" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/lock"
            android:layout_width="88dp"
            android:layout_height="84dp"
            android:layout_marginStart="2dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="21dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toEndOf="@+id/avoid_personal_tip"
            app:layout_constraintTop_toBottomOf="@+id/combination_tip"
            app:srcCompat="@drawable/ic_baseline_lock_24" />

        <androidx.cardview.widget.CardView
            android:layout_width="336dp"
            android:layout_height="260dp"
            android:layout_marginStart="58dp"
            android:layout_marginTop="100dp"
            android:layout_marginEnd="38dp"
            android:layout_marginBottom="37dp"
            android:gravity="center"
            app:cardBackgroundColor="#FB9E68"
            app:cardCornerRadius="10dp"
            app:cardElevation="5dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/avoid_personal_tip">

            <LinearLayout
                android:id="@+id/linearLayout2"
                android:layout_width="match_parent"
                android:layout_height="272dp"
                android:layout_marginTop="0dp"
                android:layout_marginBottom="29dp"
                android:orientation="vertical"
                android:padding="0dp">

                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/current_password"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_marginTop="5dp"
                    android:hint="@string/current_password"
                    android:inputType="textPassword"
                    android:textColorHint="#FFFFFF"
                    android:textStyle="bold"
                    app:backgroundTint="@android:color/holo_orange_light" />

                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/new_password"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_marginTop="5dp"

                    android:hint="@string/new_password"
                    android:inputType="textPassword"
                    android:textColorHint="#FFFFFF"
                    android:textStyle="bold"
                    app:backgroundTint="@android:color/holo_orange_light" />

                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/passwordConfirmEdit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_marginTop="5dp"
                    android:layout_marginBottom="5dp"
                    android:hint="@string/confirm_new_password"
                    android:inputType="textPassword"
                    android:textColorHint="#FFFFFF"
                    android:textStyle="bold"
                    app:backgroundTint="@android:color/holo_orange_light" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/changePasswordButton"
                    android:layout_width="151dp"
                    android:layout_height="77dp"
                    android:layout_gravity="center"
                    android:layout_marginStart="0dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginEnd="0dp"
                    android:gravity="center"
                    android:padding="4dp"
                    android:text="@string/change_password"
                    android:textColor="@android:color/holo_orange_light"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:backgroundTint="@android:color/white"
                    app:cornerRadius="10dp"
                    app:strokeColor="@android:color/holo_orange_light" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

    </androidx.constraintlayout.widget.ConstraintLayout>


</FrameLayout>