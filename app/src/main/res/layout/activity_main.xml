<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".activities.MainActivity"
    android:padding="10dp"
    android:background="@drawable/backgroundsun">


    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/signInButtonHome"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_gravity="center"
        android:layout_marginStart="88dp"
        android:layout_marginTop="350dp"
        android:layout_marginEnd="88dp"
        android:layout_marginBottom="27dp"
        android:background="@drawable/rounded_button"
        android:text="Sign in"
        android:textSize="30sp"
        app:layout_constraintBottom_toTopOf="@+id/signUpButtonHome"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.526"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="1.0" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/signUpButtonHome"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_gravity="center"
        android:layout_marginStart="88dp"
        android:layout_marginTop="480dp"
        android:layout_marginEnd="88dp"
        android:background="@drawable/rounded_button"
        android:layout_marginBottom="18dp"
        android:text="Sign up"
        android:textSize="30sp"
        app:layout_constraintBottom_toTopOf="@+id/quizTest"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/signInButtonHome"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.863" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/quizTest"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_gravity="center"
        android:layout_marginStart="66dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="66dp"
        android:background="@drawable/rounded_button"
        android:text="Quiz test"
        android:textSize="30dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/signUpButtonHome" />


    <TextView
        android:id="@+id/toukan"
        android:layout_width="168dp"
        android:layout_height="195dp"
        android:layout_margin="10dp"
        android:layout_marginStart="28dp"
        android:layout_marginBottom="48dp"
        android:text="Toukan"
        android:textColor="#363A43"
        android:textSize="50sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@+id/signInButtonHome"
        app:layout_constraintEnd_toStartOf="@+id/logoSign"
        app:layout_constraintHorizontal_bias="0.006"
        app:layout_constraintStart_toStartOf="parent" />

    <ImageView
        android:id="@+id/logoSign"
        android:layout_width="341dp"
        android:layout_height="299dp"
        android:layout_gravity="center"
        android:layout_marginStart="12dp"
        android:layout_marginTop="32dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/logotoucan" />

</androidx.constraintlayout.widget.ConstraintLayout>