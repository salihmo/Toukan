<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="350dp">


    <TextView
        android:id="@+id/quizzes_list_item_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="100dp"
        android:layout_marginEnd="100dp"
        android:gravity="center"
        android:padding="2dp"
        android:textAppearance="@style/TextAppearance.MaterialComponents.Button"
        android:textSize="25sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.258" />

    <ImageView
        android:id="@+id/stage_image"
        android:layout_width="255dp"
        android:layout_height="158dp"
        android:layout_marginStart="114dp"
        android:layout_marginTop="30dp"
        android:layout_marginEnd="114dp"
        android:foregroundGravity="center"
        android:src="@drawable/cat_icon"
        app:layout_constraintBottom_toTopOf="@+id/quizzes_list_item_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/quizzes_list_item_title"
        app:layout_constraintVertical_bias="0.914" />

    <Button
        android:id="@+id/quizzes_list_item_button"
        android:layout_width="173dp"
        android:layout_height="55dp"
        android:layout_marginStart="120dp"
        android:layout_marginEnd="120dp"
        android:foregroundGravity="center"
        android:text="@string/start"
        android:textSize="25sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.991" />

    <ImageView
        android:id="@+id/trail_image"
        android:layout_width="80dp"
        android:layout_height="65dp"
        android:layout_marginStart="114dp"
        android:layout_marginEnd="114dp"
        android:foregroundGravity="center"
        android:src="@drawable/ic_trail_three"
        app:layout_constraintBottom_toTopOf="@+id/quizzes_list_item_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>